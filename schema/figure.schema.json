{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dance Figure",
  "type": "object",
  "properties": {
    "Name": {
      "type": "string"
    },
    "Desc": {
      "type": "string"
    },
    "Anker": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "Addons": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Addon"
      },
      "default": {}
    },
    "FigureList": {
      "$ref": "#/definitions/CompositeGroup"
    },
    "Bars": {
      "type": "number"
    },
    "Version": {
      "type": [
        "number",
        "integer"
      ]
    },
    "StartPos": {
      "type": "array"
    },
    "EndPos": {
      "type": "array"
    },
    "EndFacing": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/OptionalPosition"
          },
          {
            "$ref": "#/definitions/FacingNotation"
          }
        ]
      },
      "description": "Per-dancer ending-facing target or symbolic notation"
    },
    "CriptDesc": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "StartDancers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[1-9][0-9]*[mw])?$",
        "description": "Dancer ID (couple number plus m/w); an empty string uses automatic preview allocation."
      },
      "description": "Preview dancer identifiers parallel to StartPos; runtime validates matching length and uniqueness after automatic allocation."
    },
    "StartFacing": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "array",
            "maxItems": 0
          },
          {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false
          }
        ]
      },
      "description": "Preview starting-facing targets parallel to StartPos; empty arrays use the default same-row opposite-line target. Runtime validates matching length."
    }
  },
  "not": {
    "required": [
      "Faceing"
    ]
  },
  "oneOf": [
    {
      "required": [
        "Name",
        "Desc",
        "Formation",
        "Version",
        "Addons",
        "Bars",
        "StartPos",
        "EndPos",
        "CriptDesc"
      ],
      "not": {
        "required": [
          "FigureList"
        ]
      }
    },
    {
      "required": [
        "Name",
        "Desc",
        "Formation",
        "Version",
        "FigureList"
      ],
      "not": {
        "required": [
          "Addons",
          "Bars",
          "StartPos",
          "EndPos",
          "CriptDesc"
        ]
      }
    }
  ],
  "definitions": {
    "CompositeGroup": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "type": "string",
          "enum": ["s", "p"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FigureListNode"
          }
        }
      ],
      "additionalItems": false
    },
    "FigureListNode": {
      "oneOf": [
        {
          "$ref": "#/definitions/CompositeGroup"
        },
        {
          "$ref": "#/definitions/AnchoredFigure"
        }
      ]
    },
    "AnchoredFigure": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "$ref": "#/definitions/PositionPair"
        },
        {
          "$ref": "#/definitions/FigureReference"
        }
      ],
      "additionalItems": false
    },
    "FigureReference": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "additionalItems": false
        }
      ]
    },
    "PositionPair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false
    },
    "OptionalPosition": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "$ref": "#/definitions/PositionPair"
        }
      ]
    },
    "FacingResetOrPosition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/OptionalPosition"
        },
        {
          "$ref": "#/definitions/FacingNotation"
        }
      ]
    },
    "FacingNotation": {
      "type": "string",
      "enum": ["=", "I", "O", "U", "D", "OwnL", "OpL", "M"]
    },
    "Addon": {
      "type": "object",
      "properties": {
        "Bars": {
          "type": "number"
        },
        "Name": {
          "type": "string"
        },
        "Desc": {
          "type": "string"
        },
        "Version": {
          "type": [
            "number",
            "integer"
          ]
        },
        "StartPos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OptionalPosition"
          }
        },
        "EndPos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OptionalPosition"
          }
        },
        "EndFacing": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FacingResetOrPosition"
          },
          "description": "Modified facing directions; null explicitly resets to default, while [] leaves the base entry unchanged."
        },
        "Partner": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OptionalPosition"
          }
        },
        "CriptDesc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "CriptReplace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "Name",
        "Desc",
        "Version"
      ],
      "not": {
        "required": [
          "Faceing"
        ]
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
