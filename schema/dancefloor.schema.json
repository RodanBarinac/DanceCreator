{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DanceFloor",
  "type": "object",
  "required": [
    "name",
    "couples",
    "tick",
    "positions"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "couples": {
      "type": "integer",
      "minimum": 1
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "positions": {
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]*[mw]$|^[1-9][0-9]*(?:\\.[0-9]+)?:-?[0-9]+(?:\\.[0-9]+)?$": {
          "type": "object",
          "required": [
            "dancer",
            "coord"
          ],
          "properties": {
            "dancer": {
              "type": "object",
              "required": [
                "name",
                "gender"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "gender": {
                  "type": "string",
                  "enum": [
                    "M",
                    "F",
                    "m",
                    "f"
                  ]
                }
              }
            },
            "coord": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": [
                {
                  "type": "number",
                  "minimum": 1
                },
                {
                  "type": "number",
                  "description": "Centered-grid column; may be negative"
                }
              ]
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
