{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dance Node Preview Request",
  "type": "object",
  "required": [
    "anchor",
    "addons"
  ],
  "properties": {
    "anchor": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
