{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Serialized API Floor Snapshot",
  "description": "Map from a position key to its serialized coordinate, dancer identity, and facing.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "position",
      "dancer",
      "facing"
    ],
    "properties": {
      "position": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "dancer": {
        "type": "object",
        "required": [
          "name",
          "gender"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "facing": {}
    },
    "additionalProperties": false
  }
}
