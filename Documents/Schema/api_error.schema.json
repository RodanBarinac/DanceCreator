{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "API Error",
  "type": "object",
  "required": ["status", "error", "message"],
  "properties": {
    "status": { "type": "string", "enum": ["error"] },
    "error": { "type": "string" },
    "message": { "type": "string" },
    "code": { "type": ["number", "integer"] }
  },
  "additionalProperties": true
}
