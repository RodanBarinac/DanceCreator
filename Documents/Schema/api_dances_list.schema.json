{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "API Dances List",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["file", "Name", "shape", "Version"],
    "properties": {
      "file": { "type": "string" },
      "Name": { "type": "string" },
      "Desc": { "type": "string" },
      "shape": {
        "type": "string",
        "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
      },
      "Version": { "type": ["number", "integer"] }
    },
    "additionalProperties": true
  }
}
