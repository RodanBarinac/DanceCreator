{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dance",
  "$comment": "Schema version 3; dance files must use Version 3.",
  "type": "object",
  "properties": {
    "Name": { "type": "string" },
    "Desc": { "type": "string" },
    "shape": {
      "type": "string",
      "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
    },
    "FigureList": { "$ref": "#/definitions/DanceGroup" },
    "Version": { "const": 3 }
  },
  "required": ["Name", "Desc", "FigureList", "Version"],
  "additionalProperties": true,
  "definitions": {
    "Position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "type": ["number", "integer"] },
        { "type": ["number", "integer"] }
      ]
    },
    "FigureTarget": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            { "type": "string" },
            { "type": "array" }
          ]
        }
      ]
    },
    "FigureCall": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "$ref": "#/definitions/Position" },
        { "$ref": "#/definitions/FigureTarget" }
      ]
    },
    "DanceGroup": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "type": "string", "enum": ["s", "p"] },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/DanceElement" }
        }
      ]
    },
    "DanceElement": {
      "oneOf": [
        { "$ref": "#/definitions/FigureCall" },
        { "$ref": "#/definitions/DanceGroup" }
      ]
    }
  }
}
